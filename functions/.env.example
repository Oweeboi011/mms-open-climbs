# ── Brevo (Sendinblue) email credentials ─────────────────────────────────────
# Must be set before deploying: firebase functions:secrets:set BREVO_API_KEY
# Or use .env for local emulator only (never commit the real .env)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=mmsbatch26@gmail.com

# ── App base URL (used to build email links) ──────────────────────────────────
# Plain env, not a secret; defaults to the production URL when unset. CI does
# not deploy this git-ignored file — a non-production project sets it in a
# committed functions/.env.<projectId>.
APP_URL=https://mms-open-climbs.web.app

# ── GitHub (release-note drafts from commits) ─────────────────────────────────
# Production: firebase functions:secrets:set GITHUB_TOKEN (read-only Contents).
GITHUB_TOKEN=

# ── Cloud Billing export (optional — powers the App Insights cost card) ───────
# Requires enabling BigQuery detailed usage cost export in the Cloud Billing
# Console first, then granting the Cloud Functions runtime service account
# the "BigQuery Data Viewer" and "BigQuery Job User" roles. See getBillingCost
# in functions/src/callables/insights.js for full setup steps.
BILLING_EXPORT_TABLE=your-project.your_dataset.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
