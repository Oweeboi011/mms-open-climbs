{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["firebase", "firebase-tools", "dot"],
  "workspaces": {
    ".": {
      "entry": ["src/main.jsx", "scripts/*.mjs", "tests/**/*.{js,jsx,mjs}"],
      "project": ["src/**/*.{js,jsx}", "scripts/**/*.mjs", "tests/**/*.{js,jsx,mjs}"],
      "ignoreDependencies": ["@secretlint/secretlint-rule-.*", "eslint-import-resolver-alias"]
    },
    "functions": {
      "entry": ["src/index.js", "scripts/*.mjs", "tests/**/*.test.js"],
      "project": ["src/**/*.js", "scripts/**/*.mjs", "tests/**/*.js"],
      "ignoreUnresolved": ["../appShell.generated"]
    }
  }
}
