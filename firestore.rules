rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // exists() first: get() on a missing doc yields null, and reading .data
    // off it is an evaluation error that denies the whole rule — which would
    // lock out a signed-in user whose users/ profile hasn't been created yet
    // (the Google redirect path can land there) even where they're the owner.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function climbIsOpen(climbId) {
      return get(/databases/$(database)/documents/climbs/$(climbId)).data.status == 'open';
    }
    function isRegisteredFor(climbId) {
      return isSignedIn() && request.auth.uid in
        get(/databases/$(database)/documents/climbs/$(climbId)).data.registeredUserIds;
    }

    // Which fields an update actually touches.
    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A member may *declare* a payment — "I sent ₱500, here's the receipt" —
    // but never approve one. Verifying is the admin's call, and the
    // verification record can only be cleared (which resubmitting does), not
    // written, from the client.
    //
    // NOTE: rules cannot iterate arrays, so the per-payment `status` values
    // inside `payments` are not validated here. The rolled-up paymentStatus
    // is, which is what the balance math and the review queue key off.
    function memberPaymentClaimIsHonest() {
      return (!affected().hasAny(['paymentStatus']) ||
              request.resource.data.paymentStatus in ['unpaid', 'submitted'])
        && (!affected().hasAny(['verifiedAt']) ||
              request.resource.data.verifiedAt == null)
        && (!affected().hasAny(['verifiedBy']) ||
              request.resource.data.verifiedBy == null);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      // Owners may maintain their own profile but never their own role —
      // `create` pins it to 'member', and without this an update could hand
      // the whole admin surface to anyone with a browser console.
      allow update: if isAdmin() ||
        (isOwner(userId) && !affected().hasAny(['role']));
      allow delete: if isAdmin();
    }

    match /climbs/{climbId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAdmin() ||
        (isSignedIn() &&
          isOwner(request.resource.data.userId) &&
          climbIsOpen(request.resource.data.climbId));
      // Members only ever do two things to their own registration: submit a
      // payment and upload the documents a climb requires. Everything else —
      // status, admin notes, the waiver record — is admin territory.
      // Owner branch first so the common member write never pays for the
      // users/ lookup isAdmin() needs.
      allow update: if (isOwner(resource.data.userId) &&
          affected().hasOnly([
            'paymentProofs', 'payments', 'amountPaid', 'paymentStatus',
            'paymentSubmittedAt', 'verifiedAt', 'verifiedBy', 'feeBreakdown',
            'registrationFormUpload', 'medicalCertUpload', 'updatedAt'
          ]) &&
          memberPaymentClaimIsHonest()) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    match /pageViews/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /failedRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /releaseNotes/{noteId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isAdmin());
      allow write: if isAdmin();
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /climbPrivate/{climbId} {
      // Pre-climb meeting details and resource links — genuinely restricted
      // to admins and actual registrants (climbs is publicly readable, so
      // this data must live in its own doc rather than on the climb itself).
      allow read: if isAdmin() || isRegisteredFor(climbId);
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      // Doc ID is deterministic (`${climbId}_${userId}`, enforced client-side)
      // so a duplicate submission hits this same create rule as an update,
      // which is denied below — one feedback entry per member per climb.
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.userId) &&
        request.resource.data.climbId is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      // Only the read flag may be toggled by the owner; everything else is
      // written server-side (Admin SDK bypasses rules entirely).
      allow update: if isSignedIn() && isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow create, delete: if false;
    }
  }
}
