rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function climbIsOpen(climbId) {
      return get(/databases/$(database)/documents/climbs/$(climbId)).data.status == 'open';
    }
    function isRegisteredFor(climbId) {
      return isSignedIn() && request.auth.uid in
        get(/databases/$(database)/documents/climbs/$(climbId)).data.registeredUserIds;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    match /climbs/{climbId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAdmin() ||
        (isSignedIn() &&
          isOwner(request.resource.data.userId) &&
          climbIsOpen(request.resource.data.climbId));
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    match /pageViews/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /failedRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /releaseNotes/{noteId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isAdmin());
      allow write: if isAdmin();
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /climbPrivate/{climbId} {
      // Pre-climb meeting details and resource links — genuinely restricted
      // to admins and actual registrants (climbs is publicly readable, so
      // this data must live in its own doc rather than on the climb itself).
      allow read: if isAdmin() || isRegisteredFor(climbId);
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      // Doc ID is deterministic (`${climbId}_${userId}`, enforced client-side)
      // so a duplicate submission hits this same create rule as an update,
      // which is denied below — one feedback entry per member per climb.
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.userId) &&
        request.resource.data.climbId is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      // Only the read flag may be toggled by the owner; everything else is
      // written server-side (Admin SDK bypasses rules entirely).
      allow update: if isSignedIn() && isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow create, delete: if false;
    }
  }
}
