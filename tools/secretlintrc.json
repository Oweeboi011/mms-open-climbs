{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Brevo API / SMTP key (use a Firebase secret)",
            "pattern": "/x(?:keysib|smtpsib)-[a-f0-9]{64}-[A-Za-z0-9]{16}/"
          },
          {
            "name": "Google API key (keep it in .env, read via import.meta.env / scripts/lib/env.mjs)",
            "pattern": "/AIza[0-9A-Za-z_-]{35}/"
          }
        ]
      }
    }
  ]
}
