# ── Firebase (Firebase Console → Project Settings → Your Apps → SDK setup) ────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Google Maps Embed API (optional – enables reliable map embeds on Event pages)
# Obtain from: https://console.cloud.google.com/ → Maps Embed API
VITE_GOOGLE_MAPS_API_KEY=

# ── App base URL (used for email links) ───────────────────────────────────────
VITE_APP_URL=http://localhost:5173
