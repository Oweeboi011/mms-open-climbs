rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Payment proof uploads: authenticated users can upload/read their own files.
    // Any authenticated user can read (admin access is enforced in the UI/Firestore).
    // PDFs are allowed alongside images: both payment forms accept
    // `image/*,application/pdf` and GCash receipts are often shared as PDFs,
    // so an image-only rule silently failed those uploads.
    match /payment-proofs/{climbId}/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB limit
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');

      allow read: if request.auth != null;
    }

    // Climb cover/trail images: only authenticated users can write (admin check in UI),
    // anyone can read (used in public event pages).
    match /climbs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // GCash QR codes: authenticated users write (admin check in UI), public read
    // (shown on the registration page before login).
    match /gcash-qr/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Trail images: same as climbs.
    match /trail-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Required-document templates/samples, uploaded by admins for a climb
    // (admin check enforced in the UI): registration form, medical
    // certificate, mountaineering/trekking permit, waiver of responsibility.
    match /registration-form-templates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /medical-cert-samples/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /permit-templates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /waiver-doc-templates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Required-document copies uploaded by members when they register —
    // same ownership rule as payment proofs.
    match /registration-form-uploads/{climbId}/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
      allow read: if request.auth != null;
    }
    match /medical-cert-uploads/{climbId}/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
      allow read: if request.auth != null;
    }
    match /permit-uploads/{climbId}/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
      allow read: if request.auth != null;
    }
    match /waiver-doc-uploads/{climbId}/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
      allow read: if request.auth != null;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
